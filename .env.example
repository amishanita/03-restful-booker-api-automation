# Copy to .env and adjust if needed.
# .env にコピーして必要に応じて編集してください。

BASE_URL=https://restful-booker.herokuapp.com

# Prefixed with RB_ because a bare USERNAME collides with an OS variable on Windows.
# Windows の OS 変数と衝突するため RB_ を接頭辞にしています。
RB_USERNAME=admin
RB_PASSWORD=password123

# Optional / 任意
TIMEOUT=15
MAX_RETRIES=2
NON_EXISTENT_BOOKING_ID=99999999
